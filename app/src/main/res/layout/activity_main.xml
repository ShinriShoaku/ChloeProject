<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00FF00">

    <!-- Custom Background: Gambar -->
    <ImageView
        android:id="@+id/bgImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Custom Background: Video -->
    <VideoView
        android:id="@+id/bgVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Panggung animasi (ukuran & posisi diatur lewat drag / settings) -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgIdle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imgTalk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Preview kamera kecil (opsional) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="96dp"
        android:layout_height="128dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDebug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="#88000000"
        android:padding="4dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- Tombol Pengaturan Buka BottomSheet -->
    <ImageButton
        android:id="@+id/btnOpenSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_bottom_sheet"
        android:contentDescription="Pengaturan"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/drop_down"
        app:tint="#FFFFFF" />

</FrameLayout>
